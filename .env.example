DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET_KEY=change-me
OPENAI_API_KEY=
GROQ_API_KEY=
# Email (verification and password-reset links).
# Production: set RESEND_API_KEY and use an address on your verified Resend domain as MAIL_FROM.
# Local: leave RESEND_API_KEY empty and use Gmail SMTP (MAIL_FROM = your Gmail, MAIL_PASSWORD = an App Password).
RESEND_API_KEY=
MAIL_FROM=
MAIL_PASSWORD=
MAIL_FROM_NAME=Sculpt
MAIL_REPLY_TO=
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=
DEBUG_DUMP=false
OPTIMIZE_MAX_RETRIES=2
ADMIN_CLEANUP_TOKEN=
GOOGLE_CLIENT_IDS=

# The website's address: where GitHub sends people back to, and the origin the extension trusts
DASHBOARD_URL=http://localhost:5173

# GitHub OAuth app (github.com/settings/developers). Callback URL: <APP_BASE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Payments (Razorpay). Leave empty to keep payments switched off.
# Create a Pro plan in the Razorpay dashboard (Subscriptions > Plans) and paste its ID.
# Add a webhook to https://<your-api>/billing/webhook with the subscription.* events and
# paste the secret you set there.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Rate limiting behind a proxy: which address identifies a visitor. Check GET /client-ip after
# deploying. Set ONE of these; with neither, the first X-Forwarded-For address is used (fakeable).
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=
