\documentclass[letterpaper,10.5pt]{article}

\usepackage{iftex}
\ifPDFTeX
  \usepackage[utf8]{inputenc}
\fi
\usepackage[empty]{fullpage}
\usepackage{titlesec}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage{tabularx}
\usepackage{times}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Section formatting - Classic Ivy centered or small caps with rule
\titleformat{\section}{
  \vspace{-3pt}\scshape\centering\large
}{}{0em}{}[\vspace{-6pt}\rule{\textwidth}{0.6pt}\vspace{-3pt}]

% Custom list definitions
\newcommand{\resumeItem}[1]{
  \item\small{
    {#1 \vspace{-2pt}}
  }
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item
    \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{0.97\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & #2 \\
    \end{tabular*}\vspace{-6pt}
}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.15in, label={}]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.2in]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-4pt}}

\begin{document}

%----------HEADER----------
\begin{center}
    {\Huge \textbf{ {{ resume.name | escape_tex }} }} \\ \vspace{4pt}
    \small 
    {% set contact_items = [] %}
    {% if resume.contact.location %}{% set _ = contact_items.append(resume.contact.location | escape_tex) %}{% endif %}
    {% if resume.contact.phone %}{% set _ = contact_items.append(resume.contact.phone | escape_tex) %}{% endif %}
    {% if resume.contact.email %}{% set _ = contact_items.append(resume.contact.email | escape_tex) %}{% endif %}
    {% if resume.contact.linkedin %}{% set _ = contact_items.append(resume.contact.linkedin | escape_tex) %}{% endif %}
    {% if resume.contact.github %}{% set _ = contact_items.append(resume.contact.github | escape_tex) %}{% endif %}
    {% if resume.contact.portfolio %}{% set _ = contact_items.append(resume.contact.portfolio | escape_tex) %}{% endif %}
    {{ contact_items | join(' $\cdot$ ') }}
\end{center}

{% if resume.summary %}
%-----------SUMMARY-----------
\section{Professional Summary}
\small{ {{ resume.summary | escape_tex }} }
\vspace{2pt}
{% endif %}

{% if resume.education %}
%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
    {% for edu in resume.education %}
      \resumeSubheading
        { {{ edu.institution | escape_tex }} }{ {{ edu.location | escape_tex }} }
        { {{ edu.degree | escape_tex }}{% if edu.major %}, {{ edu.major | escape_tex }}{% endif %}{% if edu.cgpa %} (GPA: {{ edu.cgpa | escape_tex }}){% endif %} }{ {{ edu.period | escape_tex }} }
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

{% if resume.experience %}
%-----------EXPERIENCE-----------
\section{Professional Experience}
  \resumeSubHeadingListStart
    {% for exp in resume.experience %}
      \resumeSubheading
        { {{ exp.company | escape_tex }} }{ {{ exp.location | escape_tex }} }
        { {{ exp.role | escape_tex }} }{ {{ exp.period | escape_tex }} }
        {% if exp.achievements %}
          \resumeItemListStart
            {% for bullet in exp.achievements %}
              \resumeItem{ {{ bullet | escape_tex }} }
            {% endfor %}
          \resumeItemListEnd
        {% endif %}
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

{% if resume.projects %}
%-----------SELECTED PROJECTS-----------
\section{Projects \& Initiatives}
    \resumeSubHeadingListStart
      {% for proj in resume.projects %}
        \resumeProjectHeading
          {\textbf{ {{ proj.name | escape_tex }} }{% if proj.description %} --- \textit{ {{ proj.description | escape_tex }} }{% endif %}{% if proj.stack_str %} (\small{ {{ proj.stack_str | escape_tex }} }){% endif %}}{ {{ proj.period | escape_tex }} }
          {% if proj.highlights %}
            \resumeItemListStart
              {% for bullet in proj.highlights %}
                \resumeItem{ {{ bullet | escape_tex }} }
              {% endfor %}
            \resumeItemListEnd
          {% endif %}
      {% endfor %}
    \resumeSubHeadingListEnd
{% endif %}

{% if resume.skills %}
%-----------SKILLS & COMPETENCIES-----------
\section{Skills \& Core Competencies}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
      {% for group in resume.skills %}
        \textbf{ {{ group.category | escape_tex }} }: { {{ group.skills | escape_tex }} } \\ \vspace{2pt}
      {% endfor %}
    }}
 \end{itemize}
{% endif %}

{% if resume.certifications %}
%-----------CERTIFICATIONS-----------
\section{Honors \& Certifications}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \small{\item{
      {% for cert in resume.certifications %}
        $\cdot$ {{ cert | escape_tex }} \hspace{1em}
      {% endfor %}
    }}
 \end{itemize}
{% endif %}

{% if resume.extracurricular %}
%-----------LEADERSHIP-----------
\section{Leadership \& Service}
  \resumeSubHeadingListStart
    {% for act in resume.extracurricular %}
      \resumeSubheading
        { {{ act.organization | escape_tex }} }{ {{ act.location | escape_tex }} }
        { {{ act.role | escape_tex }} }{ {{ act.period | escape_tex }} }
        {% if act.highlights %}
          \resumeItemListStart
            {% for bullet in act.highlights %}
              \resumeItem{ {{ bullet | escape_tex }} }
            {% endfor %}
          \resumeItemListEnd
        {% endif %}
    {% endfor %}
  \resumeSubHeadingListEnd
{% endif %}

\end{document}
